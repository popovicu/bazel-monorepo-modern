module(name = "bazel_monorepo_modern")

# Go: the rules, a pinned Go SDK that Bazel downloads, and Gazelle for
# turning go.mod into Bazel repositories.
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.50.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.2")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_google_go_cmp")

# Typst: not in the Bazel Central Registry yet, so it comes from GitHub.
bazel_dep(name = "typst-bazel")
git_override(
    module_name = "typst-bazel",
    commit = "70094cb10cd35419f13106b7547349550538df5c",  # v0.0.1
    remote = "https://github.com/popovicu/typst-bazel.git",
)

typst = use_extension("@typst-bazel//typst:extensions.bzl", "typst")
typst.toolchain(version = "0.15.1")

# A font for the cards, fetched once and checked against its hash.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "jetbrains_mono_extrabold",
    downloaded_file_path = "JetBrainsMono-ExtraBold.ttf",
    sha256 = "8e501d3a6a883e83ea4f7852804fb0894cebdd67751bb1006b37a476cef34cd6",
    url = "https://raw.githubusercontent.com/JetBrains/JetBrainsMono/v2.304/fonts/ttf/JetBrainsMono-ExtraBold.ttf",
)
